# Set these in your backend host's secret/environment settings. Never commit real values.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
DATABASE_DIR=./data
